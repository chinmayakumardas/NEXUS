NEXT_PUBLIC_SUPABASE_URL=
# Canonical HTTPS origin of this deployment, for OAuth and email auth callbacks.
# Leave blank locally to use the current browser origin.
NEXT_PUBLIC_SITE_URL=
# Preferred for current Supabase projects. A legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional Cloudflare Turnstile site key. Store its secret only in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

